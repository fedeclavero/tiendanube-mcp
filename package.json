{
  "name": "@fedeclavero/tiendanube-mcp",
  "version": "1.1.0",
  "description": "MCP server for Tiendanube / Nuvemshop that AI agents can install and configure by themselves (Claude Code, Codex, Gemini CLI, Cursor, Antigravity, VS Code, OpenCode...): 198 tools, guided workflows, OAuth login, doctor, rate-limit aware.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tiendanube-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node dist/selftest.js && node dist/clienttest.js",
    "prepare": "tsc",
    "docs": "npm run build && node scripts/gen-tools-doc.mjs",
    "doctor": "node dist/index.js doctor",
    "check": "node dist/index.js doctor"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "!dist/selftest.*",
    "!dist/clienttest.*",
    "README.md",
    "README.es.md",
    "LICENSE",
    "guides",
    "llms.txt"
  ],
  "keywords": [
    "tiendanube",
    "nuvemshop",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ecommerce",
    "claude",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "ai-agent",
    "llm",
    "argentina",
    "latam",
    "tienda-nube",
    "api",
    "antigravity",
    "gemini-cli",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedeclavero/tiendanube-mcp.git"
  },
  "homepage": "https://fedeclavero.github.io/tiendanube-mcp/",
  "bugs": {
    "url": "https://github.com/fedeclavero/tiendanube-mcp/issues"
  },
  "author": "fedeclavero"
}
